{
  "name": "ux-painter",
  "version": "1.0.0",
  "description": "UX-Painter is a web-extension that enables the creation of alternative versions of a web application by applying any combination of predefined Client-Side Web Refactorings (CSWRs). These refactorings are predefined UI transformations that intend to quickly solve user interaction problems without altering the codebase.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b --noEmit && vite build",
    "build:extension": "vite build && node scripts/copy-assets.js",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --ext ts,tsx --fix"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/juancruzgardey/ux-painter-react.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/juancruzgardey/ux-painter-react/issues"
  },
  "homepage": "https://github.com/juancruzgardey/ux-painter-react#readme",
  "devDependencies": {
    "@types/chrome": "^0.0.246",
    "@types/node": "^20.8.2",
    "@types/react": "^18.2.24",
    "@types/react-dom": "^18.2.8",
    "@typescript-eslint/eslint-plugin": "^6.7.4",
    "@typescript-eslint/parser": "^6.7.4",
    "@vitejs/plugin-react": "^4.1.0",
    "eslint": "^8.50.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.3",
    "prettier": "^3.0.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.2.2",
    "vite": "^7.1.11"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "js-combinatorics": "^0.5.4",
    "lucide-react": "^0.552.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-frame-component": "^5.2.7",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.16",
    "vanillajs-datepicker": "^1.1.4"
  }
}
