{
  "manifest_version": 3,
  "name": "UX Painter",
  "version": "1.0.0",
  "description": "A web extension for applying UI refactorings",
  "permissions": [
    "activeTab",
    "storage",
    "commands"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_icon": {
      "16": "assets/default_icon.png",
      "48": "assets/default_icon.png",
      "128": "assets/default_icon.png"
    }
  },
  "background": {
    "service_worker": "assets/background.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "assets/main.css"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "css": [
        "assets/main.css"
      ],
      "js": [
        "assets/main.js"
      ]
    }
  ],
  "commands": {
    "reload": {
      "suggested_key": {
        "default": "Ctrl+Shift+U",
        "windows": "Ctrl+Shift+U"
      },
      "description": "Reload UX Painter"
    }
  }
}
